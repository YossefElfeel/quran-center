# ===== Root / cross-cutting ignores =====
# (each subproject keeps its own .gitignore: mobile/, dashboard/)

# OS
.DS_Store
Thumbs.db
ehthumbs.db

# Editors / IDEs
.idea/
.vscode/
*.iml
*.swp
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node (in case anything lands at root)
node_modules/

# Env files / secrets — NEVER commit real values
**/.env
**/.env.local
**/.env.*.local
mobile/env/dev.json
mobile/env/prod.json
# keep the example templates:
!**/.env.example
!mobile/env/example.json

# Supabase local
supabase/.branches/
supabase/.temp/

# generated sample output (tool/gen_sample_certificate.dart)
mobile/sample_certificate.pdf

# Flutter golden test failure diffs (transient)
mobile/test/**/failures/

# Android release signing — NEVER commit
mobile/android/key.properties
*.jks
*.keystore
